{
  "ConnectionStrings": {
    "Default": "Data Source=workq.db"
  },
  "Database": {
    "AutoMigrate": false
  },
  "Jwt": {
    "Issuer": "WorkQ-Server",
    "Audience": "WorkQ-Clients",
    "Key": "WorkQ-Dev-Signing-Key-Change-Me-In-Production-0123456789ABCDEF",
    "ExpiryHours": 168
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
